DATABASE_URL=postgresql://sanctuary:sanctuary_dev@localhost:5434/sanctuary
CHRONOS_BASE_URL=http://127.0.0.1:8000
# Optional host directory containing mimic3_demo/ and/or mimic4_demo/ for the
# Docker Chronos replay. It is mounted read-only and must remain outside Git.
CHRONOS_DATA_PATH=./services/chronos/data
JWT_SECRET=replace-this-with-a-long-random-secret
PORT=3000
NODE_ENV=development
# This fork uses isolated host ports and a fork-specific Docker volume.
SANCTUARY_POSTGRES_PORT=5434
SANCTUARY_FRONTEND_PORT=8081
SANCTUARY_POSTGRES_VOLUME=sanctuary-plus-postgres
# Gemini Live configuration. Keep the permanent key server-side only.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=
GEMINI_EXTRACTION_MODEL=gemini-3.1-flash-lite
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-transcribe
GEMINI_DOCUMENT_MODEL=gemini-3.1-flash-lite
GEMINI_DIAGNOSIS_MODEL=gemini-3.6-flash
GEMINI_PRESCRIPTION_MODEL=gemini-3.6-flash
GEMINI_SOAP_MODEL=gemini-3.5-flash-lite
MEDIKIOSK_USE_EPHEMERAL_TOKENS=true
# Keep automated priority recommendations in audit-only shadow mode until the
# hospital has validated the rules against clinician-labelled cases.
MEDIKIOSK_TRIAGE_MODE=SHADOW
