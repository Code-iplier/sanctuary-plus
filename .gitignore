# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc

# TypeScript build info
*.tsbuildinfo

# Python virtual environments
.venv/
venv/

# Stray TypeScript emit artifacts accidentally placed in src/ (Vite builds to dist/)
apps/frontend/src/**/*.js
apps/frontend/src/**/*.d.ts
apps/frontend/src/**/*.d.ts.map
!apps/frontend/src/vite-env.d.ts

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

# Nx workspace data
.nx/cache
.nx/workspace-data
.nx/polygraph
.nx/self-healing
.nx/migrate-runs

# Opencode configuration (agent skills, commands, workflows)
.opencode/
.github/agents/
.github/prompts/
.github/skills/
.opencode.config.json
opencode.json

# Vite/vitest timestamps
vite.config.*.timestamp*
vitest.config.*.timestamp*
test-output

# Claude code worktrees
.claude/worktrees
.claude/settings.local.json