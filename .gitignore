dist
tmp
out-tsc

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

# Nx workspace data
.nx/cache
.nx/workspace-data
.nx/polygraph
.nx/self-healing
.nx/migrate-runs

# Opencode configuration (agent skills, commands, workflows)
.opencode/
.github/agents/
.github/prompts/
.github/skills/
.opencode.config.json
opencode.json

# Vite/vitest timestamps
vite.config.*.timestamp*
vitest.config.*.timestamp*
test-output

# Claude code worktrees
.claude/worktrees
.claude/settings.local.json
# Chronos runtime (Python) — generated/runtime files excluded; source models remain tracked
services/chronos/.venv/
services/chronos/**/__pycache__/
services/chronos/**/*.py[cod]
services/chronos/logs/
services/chronos/data/
services/chronos/**/.pytest_cache/
services/chronos/**/_features_cache_*.parquet
services/chronos/models/*/checkpoints/
services/chronos/models/*/model_metadata_prev.json
